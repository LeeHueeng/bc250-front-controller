# secrets.yaml 로 복사한 뒤 값을 채울 것 (secrets.yaml 은 git에 올라가지 않음)
# api_key 는 32바이트 base64: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "PASTE_32_BYTE_BASE64_KEY_HERE="
ota_password: "change-me"
web_password: "change-me"
ap_password: "change-me-8chars"          # 설정용 AP(bc250-front-setup) WiFi 비밀번호, 8자 이상 (2026-09-01 추가)
bc250_agent_token: "change-me-random-token"   # BC250 종료 에이전트 토큰 — BC250 의 /etc/bc250-agent.env 에 같은 값 (가이드 11장)
