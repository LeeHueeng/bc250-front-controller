	(text "ATX 24-pin plug from the PSU goes straight onto J1.  5VSB powers the ESP32 + relay at all times."
		(exclude_from_sim no)
		(at 12.7 186.08 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "fd05632b-9281-4322-937f-7c2fd7eeace8")
	)
	(text "K1: COM=PS_ON, NC=GND -> PSU is ON while the relay is idle; ESP32 drives Q1 (GPIO4 HIGH) to cut power."
		(exclude_from_sim no)
		(at 12.7 189.28 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "37a48148-f218-4fcb-9433-2472d3ae8c86")
	)
	(text "PWR_OK (5V) -> R3/R4 divider -> GPIO5.   DS18B20 bus on GPIO7 with R5 pull-up to 3V3."
		(exclude_from_sim no)
		(at 12.7 192.48 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "6dea5ad1-ec4d-4a55-9e05-59fb3fcd7362")
	)
