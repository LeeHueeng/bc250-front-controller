	(text "BC250 Front Controller - ESP32-S3 PCBA (fully assembled at JLCPCB)"
		(exclude_from_sim no)
		(at 12.7 262 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "077d686e-d855-4258-a5a2-1b8dcf67f4a7")
	)
	(text "PSU ATX 24-pin plug -> J1.  5VSB feeds the 5V rail and U2 (3V3) at all times; VBUS only through D1."
		(exclude_from_sim no)
		(at 12.7 265.2 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "a01a1864-21db-423e-9928-2008d77fdfbd")
	)
	(text "Q1 pulls PS_ON low (PSU ON) while GPIO4 is HIGH or floating (R1 pull-up) -> PSU stays on when the ESP32 is dead."
		(exclude_from_sim no)
		(at 12.7 268.4 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "3ae7469f-b8cb-42a0-bc94-d4f094f259be")
	)
	(text "GPIO4 LOW -> PSU off.  Same polarity as the relay-module wiring: keep  relay_inverted: \"true\"  in the yaml."
		(exclude_from_sim no)
		(at 12.7 271.6 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "6593fd79-6580-414f-ab92-79e808e61f6e")
	)
	(text "PWR_OK 5V -> R2/R3 -> GPIO5.  T1 on GPIO7 (R4 pull-up); T2 on GPIO7 via JP1 1-2 (default) or GPIO2 via JP1 2-3 (R5)."
		(exclude_from_sim no)
		(at 12.7 274.8 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "9be15d06-c922-43e2-9a7c-5b56652a0802")
	)
	(text "Both temp inputs work as DS18B20 (1-wire) or as 10k NTC (ADC, 4.7k reference) - see README."
		(exclude_from_sim no)
		(at 12.7 278 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "f409a848-4282-4e46-9b60-5548ffbee8d1")
	)
	(text "J2: ST7789 module on pins 1-8, or SSD1306 OLED on pins 1-4 (GND VCC SCL SDA).  J7 = external WS2812 in parallel with LED1."
		(exclude_from_sim no)
		(at 12.7 281.2 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "1e14f298-4908-4263-ac02-b46454549497")
	)
	(text "Hand-soldered by the user (not in the JLCPCB BOM): U1 module, J2 socket, LED1.  Everything else is Economic-assembly eligible."
		(exclude_from_sim no)
		(at 12.7 284.4 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "324a5991-ca6e-4600-8221-59121b4956a4")
	)
