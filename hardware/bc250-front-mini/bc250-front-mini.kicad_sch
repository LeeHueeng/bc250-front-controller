	(text "BC250 Front Controller - ESP32-S3 DevKitC-1 mini (66 x 50 mm)"
		(exclude_from_sim no)
		(at 12.7 182.88 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "daf648e5-a92d-435b-8b76-0106dab8c2e8")
	)
	(text "PSU ATX 24-pin plug -> J1.  5VSB -> DevKit 5V pin (its own LDO makes 3V3).  12V only feeds the fan header."
		(exclude_from_sim no)
		(at 12.7 186.08 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "b7f21d6d-fb72-46c6-a42d-c3326e890fa5")
	)
	(text "Q1 pulls PS_ON low (PSU ON) while GPIO4 is HIGH or floating (R1 pull-up) -> PSU stays on when the ESP32 is dead."
		(exclude_from_sim no)
		(at 12.7 189.28 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "28d01806-5a44-416a-8a0f-33dd599f9fea")
	)
	(text "GPIO4 LOW -> PSU off.  Same polarity as the relay-module wiring: keep  relay_inverted: \"true\"  in the yaml."
		(exclude_from_sim no)
		(at 12.7 192.48 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "73d788da-3ad8-439b-834d-62b5a1bfaae0")
	)
	(text "PWR_OK 5V -> R2 10k / R3 20k -> 3.3 V -> GPIO5.   DS18B20 x2 on GPIO7 (R4).   FAN TACH -> R6 10k -> GPIO11."
		(exclude_from_sim no)
		(at 12.7 195.68 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "d4c57b93-306b-4a9a-bbf0-0eaee2767707")
	)
	(text "J7 5V pin is fed through D2 (~4.3 V) so a 3.3 V data line is a valid HIGH for a WS2812B.  J2 = ST7789 via wires."
		(exclude_from_sim no)
		(at 12.7 198.88 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "8f688377-07b3-4f1e-bf5d-954c775ab4ed")
	)
